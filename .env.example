# Local Vite development only. These values remain on the Vite development server.
HIVE_API_BASE_URL=https://liable-loreen-jonathanharris-57884580.koyeb.app
HIVE_ADMIN_TOKEN=

# Cloudflare Worker production variables/secrets are configured in the
# Cloudflare dashboard, not in a VITE_ browser variable.
# HIVE_UI_ACCESS_KEY=
# HIVE_UI_SESSION_TTL_SECONDS=43200
# HIVE_UI_IDLE_TIMEOUT_SECONDS=1800

VITE_APP_NAME=HIVE

# Cloudflare Worker lifecycle configuration. The Worker resumes HIVE on login and
# pauses it on manual/idle logout when that UI session owns the wake-up.
# KOYEB_TOKEN=                 # encrypted Worker secret
# KOYEB_SERVICE_ID_HIVE=      # normal Worker variable

# Secure HIVE -> AIMS Communications Interface handoff.
# HIVE_COMMS_HANDOFF_SECRET must match the AIMS-UI Worker secret of the same name.
HIVE_COMMS_HANDOFF_SECRET=
HIVE_COMMS_ACTOR=hive-owner
HIVE_COMMS_ROLE=admin
HIVE_COMMS_URL=https://chat.jonathan-harris.online/console/

