# Local/Worker HIVE upstream configuration. Keep real bearer tokens and signing
# material out of this file; supply secrets through Wrangler/Cloudflare.
HIVE_API_BASE_URL=https://hive.example.com
# Optional comma-separated HTTPS origins used only to retry safe GET/HEAD requests.
# HIVE_API_FALLBACK_URLS=https://hive-secondary.example.com
# Upstream deadline, clamped by the Worker to 1000-30000 ms.
HIVE_API_TIMEOUT_MS=10000
# HIVE_ADMIN_TOKEN=             # required encrypted Worker secret

# Authentication/session settings.
# HIVE_UI_ACCESS_KEY=           # required encrypted Worker secret; login verification only
# HIVE_UI_SESSION_SECRET=       # required encrypted Worker secret; independent session-signing key
# HIVE_UI_SESSION_TTL_SECONDS=43200
# HIVE_UI_IDLE_TIMEOUT_SECONDS=1800

VITE_APP_NAME=HIVE

# LOGIN_RATE_LIMITER is a Cloudflare Durable Object binding, not an environment
# variable. Keep the binding and LoginRateLimiter migration in wrangler.toml.

# Cloudflare Worker lifecycle configuration. The Worker resumes HIVE and AIMS on
# login and pauses each service on manual/idle logout only when that UI session
# owns that service's wake-up. Services already active for MAST are not claimed.
# KOYEB_TOKEN=                  # encrypted Worker secret when lifecycle control is enabled
# KOYEB_SERVICE_ID_HIVE=       # normal Worker variable
# KOYEB_SERVICE_ID_AIMS=       # normal Worker variable

# Secure HIVE -> AIMS Communications Interface handoff. The dedicated signing
# secret is mandatory and must not be derived from HIVE_UI_ACCESS_KEY.
# HIVE_COMMS_HANDOFF_SECRET=   # required encrypted Worker secret
HIVE_COMMS_ACTOR=hive-owner
HIVE_COMMS_ROLE=admin
HIVE_COMMS_URL=https://chat.jonathan-harris.online/console/
